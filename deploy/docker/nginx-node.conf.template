load_module /opt/modules/ngx_http_aurora_waf_module.so;
include /var/lib/aurora-routing/dependencies/current/modules.conf;
env NODE_ROLE;
env AURORA_METRICS_SCOPE;
env NODE_VERSION;
env AURORA_SERVER_URL;
env AURORA_NODE_ID;
env AURORA_AUTH_TOKEN;
worker_processes 2;
worker_rlimit_nofile 65535;
pid /var/run/nginx.pid;
error_log /var/log/nginx/error.log notice;
worker_shutdown_timeout 30s;

events {
    worker_connections 8192;
}

http {
    include /var/lib/aurora-routing/dependencies/current/http.conf;
    include /var/lib/aurora-policy/active-extensions-http.conf;
    include /var/lib/aurora-policy/active-upstreams.conf;
    http2 on;
    include /etc/nginx/access-trusted-proxies.conf;

    aurora_waf_controller ${CONTROLLER_URL};
    aurora_waf_node_id ${NODE_ID};
    aurora_waf_token ${AUTH_TOKEN};
    aurora_waf_heartbeat_interval ${HEARTBEAT_INTERVAL};

    real_ip_header X-Real-IP;
    real_ip_recursive off;
    access_log /var/log/nginx/access.log;
    sendfile on;
    lingering_close always;
    lingering_time 30s;
    lingering_timeout 5s;
    keepalive_timeout 65s;
    keepalive_requests 100000;

    server {
        listen 80;
        server_name localhost;

        aurora_waf on;
        aurora_waf_policy /var/lib/aurora-policy/active-policy.json;
        aurora_access_policy /var/lib/aurora-policy/active-access.json;
        aurora_waf_mode enforce;
        aurora_waf_controller ${CONTROLLER_URL};
        aurora_waf_node_id ${NODE_ID};
        aurora_waf_token ${AUTH_TOKEN};
        aurora_waf_heartbeat_interval ${HEARTBEAT_INTERVAL};

        add_header X-Aurora-Node "${NODE_ID}" always;
        add_header X-Aurora-Generation $aurora_waf_generation always;
        include /var/lib/aurora-policy/active-extensions.conf;

        default_type text/plain;

        root /usr/share/aurora-demo;
        location / {
            try_files $uri =404;
        }

        location = /_aurora/config {
            default_type text/plain;
            alias /etc/nginx/aurora-config-view.conf;
        }

        location = /metrics {
            aurora_waf_metrics;
        }

        location = /stub_status {
            stub_status;
            access_log off;
            allow 127.0.0.1;
            deny all;
        }
    }
    include /var/lib/aurora-routing/active-domain-routing.conf;
    # Keep workload server first for the existing telemetry config inheritance.
    server {
        listen 127.0.0.1:9081;
        aurora_waf on;
        aurora_waf_policy /var/lib/aurora-policy/active-policy.json;
        aurora_access_policy /var/lib/aurora-policy/active-access.json;
        location = /generation { return 200 "$aurora_waf_generation"; }
        location = /access-generation { return 200 "$aurora_access_generation"; }
    }
}
