env NODE_ROLE;
env AURORA_METRICS_SCOPE;
env NODE_VERSION;
env AURORA_SERVER_URL;
env AURORA_AUTH_TOKEN;
worker_processes 2;
worker_rlimit_nofile 65535;
pid /var/run/nginx.pid;
error_log /var/log/nginx/error.log notice;
worker_shutdown_timeout 30s;

events {
    worker_connections 8192;
}

http {
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    include /var/lib/aurora-policy/active-extensions-http.conf;
    include /var/lib/aurora-policy/active-upstreams.conf;
    http2 on;
    include /etc/nginx/access-trusted-proxies.conf;

    real_ip_header X-Real-IP;
    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;
    real_ip_recursive off;
    map "" $aurora_req_id {
        default "";
    }
    map "" $aurora_trace_id {
        default "";
    }
    map $request_id $aurora_span_id {
        "~^(?<span16>[0-9a-f]{16})" $span16;
        default "0000000000000001";
    }

    log_format aurora_json escape=json '{"time_local":"$time_iso8601","remote_addr":"$remote_addr","request_method":"$request_method","request_uri":"$request_uri","status":$status,"request_time":$request_time,"body_bytes_sent":$body_bytes_sent,"host":"$host","http_user_agent":"$http_user_agent","request_id":"$aurora_req_id","trace_id":"$aurora_trace_id"}';
    access_log syslog:server=unix:/dev/shm/aurora_access.sock,nohostname aurora_json if=$gateway_log_active;
    sendfile on;
    lingering_close always;
    lingering_time 30s;
    lingering_timeout 5s;
    keepalive_timeout 65s;
    keepalive_requests 100000;

    server {
        listen 80;
        server_name localhost;

        gateway on;

        add_header X-Aurora-Generation $gateway_access_generation always;
        include /var/lib/aurora-policy/active-extensions.conf;

        default_type text/plain;

        root /usr/share/aurora-demo;
        location / {
            try_files $uri =404;
        }

        location = /_aurora/config {
            default_type text/plain;
            alias /etc/nginx/aurora-config-view.conf;
        }

        location = /metrics {
            gateway_metrics;
        }
    }


    include /var/lib/aurora-routing/active-domain-routing.conf;
    # Keep workload server first for the existing telemetry config inheritance.
    server {
        listen 127.0.0.1:9081;
        gateway on;
        location = /generation { return 200 "$gateway_access_generation"; }
        location = /access-generation { return 200 "$gateway_access_generation"; }
    }
}

stream {
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    include /var/lib/aurora-routing/active-l4-streams.conf;
}
