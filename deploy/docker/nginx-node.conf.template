load_module /opt/modules/ngx_http_aurora_waf_module.so;
worker_processes 2;
worker_rlimit_nofile 65535;
pid /var/run/nginx.pid;
error_log /var/log/nginx/error.log notice;
worker_shutdown_timeout 30s;

events {
    worker_connections 8192;
}

http {
    access_log /var/log/nginx/access.log;
    sendfile on;
    lingering_close always;
    lingering_time 30s;
    lingering_timeout 5s;
    keepalive_timeout 65s;
    keepalive_requests 100000;

    server {
        listen 80;
        server_name localhost;

        aurora_waf on;
        aurora_waf_policy /etc/nginx/active-policy.json;
        aurora_waf_mode enforce;
        aurora_waf_controller ${CONTROLLER_URL};
        aurora_waf_node_id ${NODE_ID};
        aurora_waf_token ${AUTH_TOKEN};
        aurora_waf_heartbeat_interval 1;

        add_header X-Aurora-Node "${NODE_ID}" always;
        add_header X-Aurora-Generation $aurora_waf_generation always;

        root /deploy/demo;
        default_type text/plain;

        location / {
            try_files $uri =404;
        }

        location = /metrics {
            aurora_waf_metrics;
        }
    }
}
