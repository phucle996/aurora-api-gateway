load_module /opt/modules/ngx_http_gateway_module.so;
include /var/lib/aurora-routing/dependencies/current/modules.conf;
env NODE_ROLE;
env AURORA_METRICS_SCOPE;
env NODE_VERSION;
env AURORA_SERVER_URL;
env AURORA_AUTH_TOKEN;
worker_processes 2;
worker_rlimit_nofile 65535;
pid /var/run/nginx.pid;
error_log /var/log/nginx/error.log notice;
worker_shutdown_timeout 30s;

events {
    worker_connections 8192;
}

http {
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    include /var/lib/aurora-routing/dependencies/current/http.conf;
    include /var/lib/aurora-policy/active-extensions-http.conf;
    include /var/lib/aurora-policy/active-upstreams.conf;
    http2 on;
    include /etc/nginx/access-trusted-proxies.conf;

    real_ip_header X-Real-IP;
    set_real_ip_from 127.0.0.1;
    set_real_ip_from ::1;
    real_ip_recursive off;
    access_log /var/log/nginx/access.log;
    sendfile on;
    lingering_close always;
    lingering_time 30s;
    lingering_timeout 5s;
    keepalive_timeout 65s;
    keepalive_requests 100000;

    server {
        listen 80;
        server_name localhost;

        gateway on;
        gateway_waf_policy /var/lib/aurora-policy/active-policy.json;
        gateway_access_policy /var/lib/aurora-policy/active-access.json;
        gateway_waf_mode enforce;

        add_header X-Aurora-Generation $gateway_waf_generation always;
        include /var/lib/aurora-policy/active-extensions.conf;

        default_type text/plain;

        root /usr/share/aurora-demo;
        location / {
            try_files $uri =404;
        }

        location = /_aurora/config {
            default_type text/plain;
            alias /etc/nginx/aurora-config-view.conf;
        }

        location = /metrics {
            gateway_metrics;
        }

        location = /stub_status {
            stub_status;
            access_log off;
            allow 127.0.0.1;
            deny all;
        }
    }

    # Stream Continue traffic enters through this loopback-only bridge. The stream
    # proxy sends PROXY protocol, then this server preserves the verified source IP
    # while handing the original HTTP request to the normal domain route listener.
    server {
        listen 127.0.0.1:9082 proxy_protocol;
        server_name _;

        real_ip_header proxy_protocol;
        set_real_ip_from 127.0.0.1;
        set_real_ip_from ::1;

        gateway on;
        gateway_waf_policy /var/lib/aurora-policy/active-policy.json;
        gateway_access_policy /var/lib/aurora-policy/active-access.json;
        gateway_waf_mode enforce;

        location / {
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            # The downstream L7 route appends the verified client once. Drop any
            # client-supplied chain here so Continue does not duplicate or trust it.
            proxy_set_header X-Forwarded-For "";
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_pass http://127.0.0.1:80;
        }
    }

    include /var/lib/aurora-routing/active-domain-routing.conf;
    # Keep workload server first for the existing telemetry config inheritance.
    server {
        listen 127.0.0.1:9081;
        gateway on;
        gateway_waf_policy /var/lib/aurora-policy/active-policy.json;
        gateway_access_policy /var/lib/aurora-policy/active-access.json;
        location = /generation { return 200 "$gateway_waf_generation"; }
        location = /access-generation { return 200 "$gateway_access_generation"; }
    }
}

stream {
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    include /var/lib/aurora-routing/active-l4-streams.conf;
}
