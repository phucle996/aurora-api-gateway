# Optional, offline install artifact. Nothing here is loaded until an operator installs it.
FROM ubuntu:26.04 AS builder
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake libpcre2-dev zlib1g-dev ca-certificates && rm -rf /var/lib/apt/lists/*
COPY build/nginx-source/nginx-1.30.4.tar.gz /src/nginx.tar.gz
COPY build/ngx-brotli-source /src/ngx_brotli
RUN echo '4261dc90e9e47c1c4041276e9aaa3d48ebe2e664f728e14fa95ae6c67d57a08b  /src/nginx.tar.gz' | sha256sum -c - && tar -xzf /src/nginx.tar.gz -C /src
RUN cmake -S /src/ngx_brotli/deps/brotli -B /src/ngx_brotli/deps/brotli/out -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF -DCMAKE_POSITION_INDEPENDENT_CODE=ON && cmake --build /src/ngx_brotli/deps/brotli/out --target brotlienc --parallel 2
WORKDIR /src/nginx-1.30.4
RUN ./configure --with-compat --add-dynamic-module=/src/ngx_brotli && make modules -j2
RUN mkdir /artifact && cp objs/ngx_http_brotli_*_module.so /artifact/ && cp /src/ngx_brotli/LICENSE /artifact/LICENSE.ngx_brotli && cp /src/ngx_brotli/deps/brotli/LICENSE /artifact/LICENSE.brotli && printf '1.30.4\n' > /artifact/nginx-version && uname -m > /artifact/architecture && cd /artifact && sha256sum *.so > SHA256SUMS
FROM scratch
COPY --from=builder /artifact/ /
