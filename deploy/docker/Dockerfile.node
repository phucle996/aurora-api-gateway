FROM ubuntu:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    libpcre2-8-0 \
    libzstd1 \
    zlib1g \
    ca-certificates \
    curl \
    gettext-base \
    && useradd -r -s /bin/false nginx \
    && mkdir -p /var/log/nginx /var/cache/nginx /opt/nginx /opt/modules /etc/nginx /deploy/demo \
    && rm -rf /var/lib/apt/lists/*

COPY build/nginx-runtime /opt/nginx
COPY build/modules/ngx_http_aurora_waf_module.so /opt/modules/ngx_http_aurora_waf_module.so
COPY deploy/docker/nginx-node.conf.template /etc/nginx/nginx-node.conf.template
COPY deploy/docker/entrypoint-node.sh /entrypoint.sh
COPY deploy/demo/ok /deploy/demo/ok
COPY deploy/demo/__aurora_blocked /deploy/demo/__aurora_blocked

RUN chmod +x /entrypoint.sh /opt/nginx/usr/sbin/nginx

EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]
