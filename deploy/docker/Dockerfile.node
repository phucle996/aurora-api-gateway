# ── Stage 1: Rust Builder ────────────────────────────────────────
FROM rust:1.98 AS rust-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY proto/ proto/
COPY crates/ crates/
COPY adapters/ adapters/

RUN cargo build --release -p aurora-control-worker \
    && cargo build --release -p aurora-ffi

# ── Stage 2: Static Aurora Gateway Builder ──────────────────────────
FROM debian:trixie-slim AS gateway-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    ca-certificates \
    libpcre2-dev \
    libssl-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY adapters/ adapters/
COPY --from=rust-builder /app/target/release/libaurora_ffi.a /app/target/release/libaurora_ffi.a

WORKDIR /build
RUN curl -fsSL https://nginx.org/download/nginx-1.30.4.tar.gz -o nginx-1.30.4.tar.gz \
    && tar -xzf nginx-1.30.4.tar.gz

COPY scripts/patches/ /build/patches/
WORKDIR /build/nginx-1.30.4
RUN if [ -f /build/patches/nginx-strip-static.patch ]; then patch -p1 < /build/patches/nginx-strip-static.patch; fi \
    && ./configure \
    --prefix=/etc/nginx \
    --sbin-path=/usr/local/bin/aurora-gateway \
    --conf-path=/etc/nginx/nginx.conf \
    --pid-path=/run/aurora/nginx.pid \
    --lock-path=/run/aurora/nginx.lock \
    --http-log-path=/var/log/nginx/access.log \
    --error-log-path=/var/log/nginx/error.log \
    --http-client-body-temp-path=/var/lib/aurora/client_temp \
    --http-proxy-temp-path=/var/lib/aurora/proxy_temp \
    --without-http_fastcgi_module \
    --without-http_uwsgi_module \
    --without-http_scgi_module \
    --without-http_memcached_module \
    --without-http_empty_gif_module \
    --without-http_browser_module \
    --without-http_autoindex_module \
    --without-http_ssi_module \
    --without-http_userid_module \
    --without-http_split_clients_module \
    --without-http_static_module \
    --without-http_index_module \
    --with-compat \
    --with-http_ssl_module \
    --with-http_v2_module \
    --with-http_realip_module \
    --with-http_stub_status_module \
    --with-stream \
    --with-stream_ssl_module \
    --with-stream_realip_module \
    --add-module=/app/adapters/nginx \
    && make -j$(nproc) \
    && mkdir -p /opt/bin \
    && cp objs/nginx /opt/bin/aurora-gateway

# ── Stage 3: Production Runtime ──────────────────────────────────
FROM debian:trixie-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3t64 \
    libpcre2-8-0 \
    libzstd1 \
    zlib1g \
    ca-certificates \
    curl \
    jq \
    gettext-base \
    && useradd -r -s /bin/false nginx \
    && mkdir -p /var/log/nginx /var/cache/nginx /run/aurora /var/lib/aurora /etc/nginx /opt/aurora-dependencies /opt/nginx/usr/sbin /opt/modules \
    && rm -rf /var/lib/apt/lists/*

COPY --from=gateway-builder /opt/bin/aurora-gateway /usr/local/bin/aurora-gateway
COPY --from=rust-builder /app/target/release/aurora-control-worker /usr/local/bin/aurora-control-worker

COPY deploy/docker/nginx-node.conf.template /etc/nginx/nginx-node.conf.template
COPY deploy/docker/entrypoint-node.sh /entrypoint.sh

RUN chmod +x /usr/local/bin/aurora-control-worker /usr/local/bin/aurora-gateway /entrypoint.sh

EXPOSE 80 443 9145

ENTRYPOINT ["/entrypoint.sh"]
