    },
    {
      "id": "6e8c4d51",
      "type": "text",
      "x": 710,
      "y": 975,
      "width": 586.3000000000001,
      "height": 57.2,
      "angle": 0,
      "strokeColor": "#065f46",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 3105,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "• Tốc độ cực hạn: Chi phí ranh giới O(1), chỉ tốn vài nanosecond truyền thanh ghi.\n• Không tốn thêm RAM: Dữ liệu nằm nguyên vị trí trong bộ đệm của NGINX.\n• An toàn bộ nhớ tuyệt đối: Trình biên dịch Rust bảo đảm không có lỗi con trỏ.\n• Độ trễ đuôi P99 phẳng lỳ: Không GC pause, không phân mảnh RAM.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 11,
      "lineHeight": 1.3
    }
