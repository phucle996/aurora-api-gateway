      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "• 1 Tiến trình OS 🖥️\n• 2 Vùng đệm RAM 💾💾\n• Chi phí: O(N) copy\n• Tốn CPU theo size 📈\n• Nguy cơ GC pause\n• Latency: 50 - 200 µs",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "lineHeight": 1.3
