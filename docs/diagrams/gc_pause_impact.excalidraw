      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "🛑 TÁC HẠI CỦA KHOẢNG DỪNG THU GOM RÁC (GC PAUSE) TRONG HỆ THỐNG HIỆU NĂNG CAO",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 24,
      "lineHeight": 1.3
    },
    {
      "id": "e17fa2a5",
      "type": "text",
      "x": 300,
      "y": 68,
      "width": 1001.0,
      "height": 20,
      "angle": 0,
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 7001,
      "version": 1,
      "versionNonce": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Giải thích vì sao vài phần nghìn giây (milliseconds) dừng lại dọn rác là sự lãng phí nghiêm trọng ở quy mô lớn",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "lineHeight": 1.3
    },
