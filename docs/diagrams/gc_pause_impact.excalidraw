      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "❌  HỆ THỐNG CÓ BỘ THU GOM RÁC GC (Ví dụ: LuaJIT trong Kong/APISIX, hoặc Go Gateway)",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 17,
      "lineHeight": 1.3
    },
    {
