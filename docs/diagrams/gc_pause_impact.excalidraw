      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Cơ chế: Chương trình chạy bình thường ➔ RAM đầy ➔ Stop-The-World (Dừng cả hệ thống) để dọn rác",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 13,
      "lineHeight": 1.3
    },
