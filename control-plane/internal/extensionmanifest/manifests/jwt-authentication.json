{
  "key": "builtin/jwt-authentication",
  "version": 1,
  "id": "jwt-authentication",
  "name": "JWT Authentication",
  "category": "authorization_security",
  "description": "Validates scoped JWT bearer tokens (HS256, RS256, ES256) per origin with exclude paths and claims forwarding.",
  "renderer": "engine-jwt-rs256",
  "builtin": true,
  "default_config": {
    "rules": []
  },
  "required_for_enable": [
    "rules"
  ],
  "ui_schema": {
    "layout_type": "table",
    "fields": [],
    "table_columns": [
      {
        "key": "id",
        "label": "ID"
      },
      {
        "key": "host",
        "label": "Origin (Host)"
      },
      {
        "key": "algorithm",
        "label": "Algorithm"
      },
      {
        "key": "issuer",
        "label": "Issuer"
      },
      {
        "key": "audience",
        "label": "Audience"
      }
    ],
    "row_fields": [
      {
        "key": "id",
        "label": "Origin Rule ID",
        "type": "text",
        "required": true
      },
      {
        "key": "priority",
        "label": "Priority",
        "type": "number"
      },
      {
        "key": "host",
        "label": "Origin (Host / Domain)",
        "type": "text",
        "required": true
      },
      {
        "key": "path_prefix",
        "label": "Base Path Prefix",
        "type": "text"
      },
      {
        "key": "algorithm",
        "label": "Algorithm",
        "type": "select",
        "options": [
          {
            "label": "RS256 (RSA 2048/4096)",
            "value": "RS256"
          },
          {
            "label": "HS256 (HMAC Shared Secret)",
            "value": "HS256"
          },
          {
            "label": "ES256 (ECDSA P-256)",
            "value": "ES256"
          },
          {
            "label": "RS384",
            "value": "RS384"
          },
          {
            "label": "RS512",
            "value": "RS512"
          },
          {
            "label": "HS384",
            "value": "HS384"
          },
          {
            "label": "HS512",
            "value": "HS512"
          }
        ]
      },
      {
        "key": "secret",
        "label": "HMAC Shared Secret (for HS256/384/512)",
        "type": "password"
      },
      {
        "key": "public_key_pem",
        "label": "Public Key PEM (for RS/ES/EdDSA)",
        "type": "textarea_code"
      },
      {
        "key": "exclude_paths",
        "label": "Exclude Paths (Bypass without Token)",
        "type": "list_string"
      },
      {
        "key": "require_exp",
        "label": "Require Expiration (exp claim)",
        "type": "boolean"
      },
      {
        "key": "validate_nbf",
        "label": "Validate Not Before (nbf claim)",
        "type": "boolean"
      },
      {
        "key": "clock_skew_secs",
        "label": "Clock skew (seconds)",
        "type": "number"
      },
      {
        "key": "issuer",
        "label": "Issuer (iss)",
        "type": "text"
      },
      {
        "key": "audience",
        "label": "Audience (aud)",
        "type": "text"
      },
      {
        "key": "claim_rules",
        "label": "Claim Validation & Header Forwarding Matrix",
        "type": "list_object",
        "object_fields": [
          {
            "key": "payload_key",
            "label": "Payload Key",
            "type": "text",
            "required": true
          },
          {
            "key": "values_match",
            "label": "Values Match (Regex or *)",
            "type": "text"
          },
          {
            "key": "header_key",
            "label": "Forward Header Key",
            "type": "text"
          },
          {
            "key": "required",
            "label": "Required Claim",
            "type": "boolean"
          }
        ]
      }
    ]
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": true,
    "required": [
      "rules"
    ],
    "properties": {
      "rules": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 128
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "host": {
              "type": "string",
              "maxLength": 253
            },
            "origin": {
              "type": "string",
              "maxLength": 253
            },
            "path_prefix": {
              "type": "string",
              "maxLength": 8192
            },
            "exclude_paths": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "algorithm": {
              "type": "string",
              "maxLength": 16
            },
            "secret": {
              "type": "string",
              "maxLength": 4096
            },
            "public_key_pem": {
              "type": "string",
              "maxLength": 8192
            },
            "keys": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "kid": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "public_key_pem": {
                    "type": "string",
                    "maxLength": 8192
                  },
                  "secret": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "is_primary": {
                    "type": "boolean"
                  }
                }
              }
            },
            "issuer": {
              "type": "string",
              "maxLength": 512
            },
            "audience": {
              "type": "string",
              "maxLength": 512
            },
            "require_exp": {
              "type": "boolean"
            },
            "validate_nbf": {
              "type": "boolean"
            },
            "clock_skew_secs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300
            },
            "claim_rules": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "payload_key"
                ],
                "properties": {
                  "payload_key": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "values_match": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "header_key": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "required": {
                    "type": "boolean"
                  }
                }
              }
            },
            "forward_headers": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "payload_key",
                  "header_key"
                ],
                "properties": {
                  "payload_key": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "header_key": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 256
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}