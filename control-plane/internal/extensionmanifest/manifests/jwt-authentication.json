{
  "key": "builtin/jwt-authentication",
  "version": 1,
  "id": "jwt-authentication",
  "name": "JWT Authentication",
  "category": "authorization_security",
  "description": "Validates scoped JWT bearer tokens (HS256, RS256, ES256) per origin with exclude paths and claims forwarding.",
  "renderer": "engine-jwt-rs256",
  "builtin": true,
  "default_config": {
    "rules": []
  },
  "required_for_enable": [
    "rules"
  ],
  "ui_schema": {
    "layout_type": "table",
    "fields": [],
    "table_columns": [
      {
        "key": "id",
        "label": "ID"
      },
      {
        "key": "host",
        "label": "Origin (Host)"
      },
      {
        "key": "algorithm",
        "label": "Algorithm"
      },
      {
        "key": "issuer",
        "label": "Issuer"
      },
      {
        "key": "audience",
        "label": "Audience"
      }
    ],
    "row_fields": [
      {
        "key": "id",
        "label": "Origin Rule ID",
        "type": "text",
        "required": true
      },
      {
        "key": "priority",
        "label": "Priority",
        "type": "number"
      },
      {
        "key": "host",
        "label": "Origin (Host / Domain)",
        "type": "text",
        "required": true
      },
      {
        "key": "path_prefix",
        "label": "Base Path Prefix",
        "type": "text"
      },
      {
        "key": "algorithm",
        "label": "Algorithm",
        "type": "select",
        "options": [
          {
            "label": "RS256 (RSA 2048/4096)",
            "value": "RS256"
          },
          {
            "label": "HS256 (HMAC Shared Secret)",
            "value": "HS256"
          },
          {
            "label": "ES256 (ECDSA P-256)",
            "value": "ES256"
          },
          {
            "label": "RS384",
            "value": "RS384"
          },
          {
            "label": "RS512",
            "value": "RS512"
          },
          {
            "label": "HS384",
            "value": "HS384"
          },
          {
            "label": "HS512",
            "value": "HS512"
          }
        ]
      },
      {
        "key": "secret",
        "label": "HMAC Shared Secret (for HS256/384/512)",
        "type": "password"
      },
      {
        "key": "public_key_pem",
        "label": "Public Key PEM (for RS/ES)",
        "type": "textarea_code"
      },
      {
        "key": "exclude_paths",
        "label": "Exclude Paths (Bypass without Token)",
        "type": "list_string"
      },
      {
        "key": "issuer",
        "label": "Issuer (iss)",
        "type": "text"
      },
      {
        "key": "audience",
        "label": "Audience (aud)",
        "type": "text"
      },
      {
        "key": "clock_skew_secs",
        "label": "Clock skew (seconds)",
        "type": "number"
      }
    ]
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": true,
    "required": [
      "rules"
    ],
    "properties": {
      "rules": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 128
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "host": {
              "type": "string",
              "maxLength": 253
            },
            "origin": {
              "type": "string",
              "maxLength": 253
            },
            "path_prefix": {
              "type": "string",
              "maxLength": 8192
            },
            "algorithm": {
              "type": "string",
              "maxLength": 16
            },
            "secret": {
              "type": "string",
              "maxLength": 4096
            },
            "public_key_pem": {
              "type": "string",
              "maxLength": 8192
            },
            "issuer": {
              "type": "string",
              "maxLength": 512
            },
            "audience": {
              "type": "string",
              "maxLength": 512
            },
            "clock_skew_secs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300
            }
          }
        }
      }
    }
  }
}