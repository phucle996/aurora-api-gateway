{
  "key": "builtin/jwt-authentication",
  "version": 1,
  "id": "jwt-authentication",
  "name": "JWT Authentication",
  "category": "authorization_security",
  "description": "Validates scoped JWT bearer tokens (HS256, RS256, ES256) per origin with exclude paths and claims forwarding.",
  "renderer": "engine-jwt-rs256",
  "builtin": true,
  "default_config": {
    "rules": []
  },
  "required_for_enable": [
    "rules"
  ],
  "ui_schema": {
    "layout_type": "table",
    "fields": [],
    "table_columns": [
      {
        "key": "id",
        "label": "ID"
      },
      {
        "key": "host",
        "label": "Origin (Host)"
      },
      {
        "key": "algorithm",
        "label": "Algorithm"
      },
      {
        "key": "issuer",
        "label": "Issuer"
      },
      {
        "key": "audience",
        "label": "Audience"
      }
    ],
    "row_fields": [
      {
        "key": "id",
        "label": "Origin Rule ID",
        "type": "text",
        "required": true,
        "placeholder": "shop-api-prod"
      },
      {
        "key": "priority",
        "label": "Priority",
        "type": "number",
        "default": 0
      },
      {
        "key": "host",
        "label": "Origin (Host / Domain)",
        "type": "text",
        "required": true,
        "placeholder": "api.shop.local"
      },
      {
        "key": "path_prefix",
        "label": "Base Path Prefix",
        "type": "text",
        "required": true,
        "default": "/",
        "placeholder": "/api"
      },
      {
        "key": "algorithm",
        "label": "Algorithm",
        "type": "select",
        "required": true,
        "default": "RS256",
        "options": [
          {
            "label": "RS256 (RSA 2048/4096)",
            "value": "RS256"
          },
          {
            "label": "HS256 (HMAC Shared Secret)",
            "value": "HS256"
          },
          {
            "label": "ES256 (ECDSA P-256)",
            "value": "ES256"
          },
          {
            "label": "RS384",
            "value": "RS384"
          },
          {
            "label": "RS512",
            "value": "RS512"
          },
          {
            "label": "HS384",
            "value": "HS384"
          },
          {
            "label": "HS512",
            "value": "HS512"
          },
          {
            "label": "ES384 (ECDSA P-384)",
            "value": "ES384"
          },
          {
            "label": "EdDSA (Ed25519)",
            "value": "EdDSA"
          }
        ]
      },
      {
        "key": "secret",
        "label": "HMAC Shared Secret (for HS256/384/512)",
        "type": "password"
      },
      {
        "key": "public_key_pem",
        "label": "Public Key PEM (for RS/ES/EdDSA)",
        "type": "textarea_code"
      },
      {
        "key": "exclude_paths",
        "label": "Exclude Paths (Bypass without Token)",
        "type": "list_string"
      },
      {
        "key": "validate_exp",
        "label": "Validate Expiration (verify exp timestamp)",
        "type": "boolean",
        "default": true
      },
      {
        "key": "require_exp",
        "label": "Require Expiration (exp claim)",
        "type": "boolean",
        "default": true
      },
      {
        "key": "validate_nbf",
        "label": "Validate Not Before (nbf claim)",
        "type": "boolean",
        "default": false
      },
      {
        "key": "clock_skew_secs",
        "label": "Clock skew (seconds)",
        "type": "number",
        "default": 60
      },
      {
        "key": "issuer",
        "label": "Issuer (iss)",
        "type": "text"
      },
      {
        "key": "audience",
        "label": "Audience (aud)",
        "type": "text"
      },
      {
        "key": "token_source",
        "label": "Token Source (Header or Cookie)",
        "type": "select",
        "required": true,
        "default": "header",
        "options": [
          {
            "label": "HTTP Header (e.g. Authorization)",
            "value": "header"
          },
          {
            "label": "HTTP Cookie (e.g. access_token)",
            "value": "cookie"
          }
        ]
      },
      {
        "key": "header_name",
        "label": "Header Name (e.g. Authorization or X-Auth-Token)",
        "type": "text",
        "default": "Authorization",
        "placeholder": "Authorization"
      },
      {
        "key": "cookie_name",
        "label": "Cookie Name (e.g. access_token or session)",
        "type": "text",
        "placeholder": "access_token"
      },
      {
        "key": "token_prefix",
        "label": "Token Prefix (e.g. 'Bearer ')",
        "type": "text",
        "default": "Bearer ",
        "placeholder": "Bearer "
      },
      {
        "key": "payload_format",
        "label": "Payload Format",
        "type": "select",
        "required": true,
        "default": "json",
        "options": [
          {
            "label": "JSON Object (Structured claims via dot-notation)",
            "value": "json"
          },
          {
            "label": "RAW String (Custom text/delimiters via regex capture)",
            "value": "raw"
          }
        ]
      },
      {
        "key": "claim_rules",
        "label": "Claim Validation & Header Forwarding Matrix",
        "type": "list_object",
        "object_fields": [
          {
            "key": "payload_key",
            "label": "Payload Key",
            "type": "text",
            "required": true
          },
          {
            "key": "values_match",
            "label": "Values Match (Regex or *)",
            "type": "text"
          },
          {
            "key": "header_key",
            "label": "Forward Header Key",
            "type": "text"
          },
          {
            "key": "required",
            "label": "Required Claim",
            "type": "boolean"
          }
        ]
      }
    ]
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": true,
    "required": [
      "rules"
    ],
    "properties": {
      "rules": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "id",
            "host",
            "path_prefix",
            "algorithm",
            "token_source"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 128
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "host": {
              "type": "string",
              "maxLength": 253
            },
            "origin": {
              "type": "string",
              "maxLength": 253
            },
            "path_prefix": {
              "type": "string",
              "maxLength": 8192,
              "pattern": "^/.*"
            },
            "exclude_paths": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "maxLength": 8192
              }
            },
            "algorithm": {
              "type": "string",
              "maxLength": 16,
              "enum": [
                "RS256",
                "RS384",
                "RS512",
                "HS256",
                "HS384",
                "HS512",
                "ES256",
                "ES384",
                "EdDSA",
                "ED25519"
              ]
            },
            "secret": {
              "type": "string",
              "maxLength": 4096
            },
            "public_key_pem": {
              "type": "string",
              "maxLength": 8192
            },
            "keys": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "kid": {
                    "type": "string",
                    "maxLength": 128
                  },
                  "public_key_pem": {
                    "type": "string",
                    "maxLength": 8192
                  },
                  "secret": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "is_primary": {
                    "type": "boolean"
                  }
                }
              }
            },
            "issuer": {
              "type": "string",
              "maxLength": 512
            },
            "audience": {
              "type": "string",
              "maxLength": 512
            },
            "token_source": {
              "type": "string",
              "enum": [
                "header",
                "cookie"
              ]
            },
            "header_name": {
              "type": "string",
              "maxLength": 64
            },
            "cookie_name": {
              "type": "string",
              "maxLength": 64
            },
            "token_prefix": {
              "type": "string",
              "maxLength": 64
            },
            "payload_format": {
              "type": "string",
              "enum": [
                "json",
                "raw"
              ]
            },
            "validate_exp": {
              "type": "boolean"
            },
            "require_exp": {
              "type": "boolean"
            },
            "validate_nbf": {
              "type": "boolean"
            },
            "clock_skew_secs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 300
            },
            "claim_rules": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": [
                  "payload_key"
                ],
                "properties": {
                  "payload_key": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "values_match": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "header_key": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "required": {
                    "type": "boolean"
                  }
                }
              }
            },
            "revoked_tokens": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "revoked_jtis": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "redis": {
              "type": "object",
              "default": {},
              "properties": {
                "endpoint": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                },
                "db": {
                  "type": "integer"
                },
                "timeout_ms": {
                  "type": "integer",
                  "default": 50
                },
                "pool_size": {
                  "type": "integer",
                  "default": 8
                }
              }
            }
          }
        }
      }
    }
  }
}