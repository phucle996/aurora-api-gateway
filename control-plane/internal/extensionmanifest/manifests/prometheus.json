{
  "key": "builtin/prometheus",
  "version": 1,
  "id": "prometheus",
  "name": "Prometheus Metrics",
  "category": "observability",
  "description": "Runs the agent metrics exporter.",
  "renderer": "agent-metrics",
  "builtin": true,
  "default_config": {
    "port": 9145,
    "prometheus": {
      "enabled": true,
      "path": "/metrics"
    }
  },
  "ui_schema": {
    "layout_type": "form",
    "fields": []
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "port": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 65535
      },
      "stub_status_url": {
        "type": "string",
        "maxLength": 2048
      },
      "prometheus": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "path": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "otlp": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "endpoint": {
            "type": "string",
            "maxLength": 2048
          },
          "interval_secs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        }
      }
    }
  }
}
