{
  "key": "builtin/rate-limit-local",
  "version": 1,
  "id": "rate-limit-local",
  "name": "Local Rate Limit",
  "category": "traffic_control",
  "description": "Node-local request limiting.",
  "renderer": "nginx-rate-limit-local",
  "builtin": true,
  "default_config": {
    "refill_rate": 100,
    "capacity": 1000,
    "rejected_code": 429
  },
  "ui_schema": {
    "layout_type": "form",
    "fields": []
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "refill_rate": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000
      },
      "capacity": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1000000
      },
      "rejected_code": {
        "type": "integer",
        "minimum": 400,
        "maximum": 599
      }
    }
  }
}
