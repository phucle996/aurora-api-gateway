{
  "key": "builtin/opentelemetry-logs",
  "version": 1,
  "id": "opentelemetry-logs",
  "name": "OpenTelemetry Logs",
  "category": "observability",
  "description": "Asynchronously exports structured HTTP access and security audit logs to OpenTelemetry Collector via OTLP (HTTP/gRPC).",
  "renderer": "opentelemetry-logs",
  "builtin": true,
  "default_config": {
    "enabled": true,
    "endpoint": "http://127.0.0.1:4318",
    "protocol": "http",
    "batch_size": 100,
    "flush_interval_ms": 2000,
    "timeout_ms": 5000,
    "service_name": "aurora-gateway",
    "log_level": "info"
  },
  "ui_schema": {
    "layout_type": "form",
    "fields": [
      {
        "key": "endpoint",
        "label": "Collector Endpoint",
        "type": "text",
        "description": "Địa chỉ OTel Collector (ví dụ: http://127.0.0.1:4318 cho HTTP hoặc http://127.0.0.1:4317 cho gRPC)",
        "required": true
      },
      {
        "key": "protocol",
        "label": "Protocol",
        "type": "select",
        "options": [
          {
            "label": "HTTP (JSON/Protobuf - port 4318)",
            "value": "http"
          },
          {
            "label": "gRPC (port 4317)",
            "value": "grpc"
          }
        ],
        "description": "Giao thức truyền dữ liệu OTLP",
        "required": true
      },
      {
        "key": "batch_size",
        "label": "Batch Size",
        "type": "number",
        "description": "Số lượng log records tối đa trong một batch gửi (1 - 5000, mặc định: 100)",
        "required": true
      },
      {
        "key": "flush_interval_ms",
        "label": "Flush Interval (ms)",
        "type": "number",
        "description": "Chu kỳ tối đa đẩy logs nếu chưa đầy batch (100 - 60000ms, mặc định: 2000)",
        "required": true
      },
      {
        "key": "service_name",
        "label": "Service Name",
        "type": "text",
        "description": "Tên service gắn vào resource attributes của logs (mặc định: aurora-gateway)",
        "required": true
      },
      {
        "key": "timeout_ms",
        "label": "Request Timeout (ms)",
        "type": "number",
        "description": "Thời gian timeout tối đa cho mỗi lần export logs (ms)",
        "required": true
      },
      {
        "key": "log_level",
        "label": "Log Level Filter",
        "type": "select",
        "options": [
          {
            "label": "INFO (Standard Access + Security)",
            "value": "info"
          },
          {
            "label": "WARN (Warnings & Throttled)",
            "value": "warn"
          },
          {
            "label": "ERROR (WAF Blocks & 5xx Only)",
            "value": "error"
          },
          {
            "label": "ALL (Capture All Severity Levels)",
            "value": "all"
          }
        ],
        "description": "Mức độ log tối thiểu cần xuất sang Collector",
        "required": true
      }
    ]
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "enabled",
      "endpoint",
      "protocol",
      "batch_size",
      "flush_interval_ms",
      "timeout_ms",
      "service_name",
      "log_level"
    ],
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "endpoint": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "protocol": {
        "type": "string",
        "enum": [
          "http",
          "grpc"
        ]
      },
      "batch_size": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5000
      },
      "flush_interval_ms": {
        "type": "integer",
        "minimum": 100,
        "maximum": 60000
      },
      "timeout_ms": {
        "type": "integer",
        "minimum": 100,
        "maximum": 60000
      },
      "service_name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "log_level": {
        "type": "string",
        "enum": [
          "info",
          "warn",
          "error",
          "all"
        ]
      }
    }
  }
}
