{
  "key": "builtin/request-mirror",
  "version": 1,
  "id": "request-mirror",
  "name": "Request Mirror",
  "category": "traffic_control",
  "description": "Zero-downtime out-of-band request mirroring (shadowing) to secondary backends with single primary authority.",
  "renderer": "request-mirror",
  "builtin": true,
  "default_config": {
    "enabled": true,
    "primary_upstream": "app_production",
    "mirror_upstream": "shadow_backend",
    "sample_percentage": 100,
    "ignore_mirror_errors": true
  },
  "ui_schema": {
    "layout_type": "form",
    "fields": []
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "primary_upstream": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "mirror_upstream": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "sample_percentage": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "ignore_mirror_errors": {
        "type": "boolean"
      },
      "rules": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "primary_upstream",
            "mirror_upstream"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "origin": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "path_prefix": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "methods": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "DELETE",
                  "PATCH",
                  "HEAD",
                  "OPTIONS"
                ]
              }
            },
            "primary_upstream": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "mirror_upstream": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "sample_percentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "ignore_mirror_errors": {
              "type": "boolean"
            },
            "mirror_headers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "value"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "value": {
                    "type": "string",
                    "maxLength": 256
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}