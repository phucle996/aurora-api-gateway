    "type": "object",
    "additionalProperties": false,
    "properties": {
      "rate_kb_per_sec": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000000
      },
      "burst_kb": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000000
      }
    }
  }
}
