{
  "key": "builtin/bandwidth-limit",
  "version": 1,
  "id": "bandwidth-limit",
  "name": "Bandwidth Limit",
  "category": "traffic_control",
  "description": "Per-response bandwidth limiting.",
  "renderer": "nginx-bandwidth-limit",
  "builtin": true,
  "default_config": {
    "rate_kb_per_sec": 1024
