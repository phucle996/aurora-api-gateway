{
  "key": "builtin/rate-limit",
  "version": 1,
  "id": "rate-limit",
  "name": "Rate Limit",
  "category": "traffic_control",
  "description": "High-performance in-process rate limiting with multi-algorithm and memory bounds.",
  "renderer": "rate-limit",
  "builtin": true,
  "default_config": {
    "mode": "local",
    "algorithm": "token_bucket",
    "memory_size_mb": 16,
    "max_keys": 100000,
    "eviction_policy": "lru",
    "overflow_strategy": "evict_and_track",
    "redis": {
      "endpoint": "redis://127.0.0.1:6379",
      "timeout_ms": 10,
      "pool_size": 8,
      "on_error": "fallback_local",
      "reconnect_interval_secs": 5
    },
    "rules": []
  },
  "ui_schema": {
    "layout_type": "table",
    "fields": [
      {
        "key": "mode",
        "label": "Deployment Mode",
        "type": "select",
        "options": [
          {
            "label": "Local (In-Memory)",
            "value": "local"
          },
          {
            "label": "Distributed (Redis Cluster)",
            "value": "distributed"
          }
        ]
      },
      {
        "key": "redis.endpoint",
        "label": "Redis Endpoint",
        "type": "text"
      },
      {
        "key": "redis.on_error",
        "label": "Action on Redis Failure",
        "type": "select",
        "options": [
          {
            "label": "Fallback to Local (In-Memory)",
            "value": "fallback_local"
          },
          {
            "label": "Pass (Fail-Open)",
            "value": "pass"
          },
          {
            "label": "Block (Fail-Closed)",
            "value": "block"
          }
        ]
      },
      {
        "key": "redis.timeout_ms",
        "label": "Redis Timeout (ms)",
        "type": "number"
      },
      {
        "key": "redis.pool_size",
        "label": "Redis Pool Size",
        "type": "number"
      },
      {
        "key": "redis.custom_lua_script",
        "label": "Custom Redis Lua Script",
        "type": "text"
      },
      {
        "key": "algorithm",
        "label": "Algorithm",
        "type": "select",
        "options": [
          {
            "label": "Token Bucket",
            "value": "token_bucket"
          },
          {
            "label": "Leaky Bucket",
            "value": "leaky_bucket"
          },
          {
            "label": "Fixed Window",
            "value": "fixed_window"
          },
          {
            "label": "Sliding Window",
            "value": "sliding_window"
          }
        ]
      },
      {
        "key": "memory_size_mb",
        "label": "Memory Limit (MB)",
        "type": "number"
      },
      {
        "key": "max_keys",
        "label": "Max Tracked Keys",
        "type": "number"
      },
      {
        "key": "eviction_policy",
        "label": "Eviction Policy",
        "type": "select",
        "options": [
          {
            "label": "Least Recently Used (LRU)",
            "value": "lru"
          },
          {
            "label": "Least Frequently Used (LFU)",
            "value": "lfu"
          },
          {
            "label": "First In, First Out (FIFO)",
            "value": "fifo"
          }
        ]
      },
      {
        "key": "overflow_strategy",
        "label": "Overflow Strategy",
        "type": "select",
        "options": [
          {
            "label": "Evict and Track",
            "value": "evict_and_track"
          },
          {
            "label": "Drop New Requests",
            "value": "drop_new"
          },
          {
            "label": "Bypass New Requests",
            "value": "bypass_new"
          }
        ]
      }
    ],
    "table_columns": [
      {
        "key": "id",
        "label": "Rule ID"
      },
      {
        "key": "path_prefix",
        "label": "Path Prefix"
      },
      {
        "key": "limit_by",
        "label": "Limit By"
      },
      {
        "key": "rate",
        "label": "Rate"
      },
      {
        "key": "period_secs",
        "label": "Period (s)"
      },
      {
        "key": "action_on_exceeded",
        "label": "Action"
      }
    ],
    "row_fields": [
      {
        "key": "id",
        "label": "Rule ID",
        "type": "text",
        "required": true
      },
      {
        "key": "priority",
        "label": "Priority",
        "type": "number"
      },
      {
        "key": "host",
        "label": "Host",
        "type": "text"
      },
      {
        "key": "path_prefix",
        "label": "Path Prefix",
        "type": "text",
        "required": true
      },
      {
        "key": "limit_by",
        "label": "Limit By",
        "type": "select",
        "options": [
          {
            "label": "Client IP",
            "value": "client_ip"
          },
          {
            "label": "Header",
            "value": "header"
          },
          {
            "label": "Route Path",
            "value": "route_path"
          }
        ]
      },
      {
        "key": "header_name",
        "label": "Header Name",
        "type": "text"
      },
      {
        "key": "rate",
        "label": "Rate",
        "type": "number",
        "required": true
      },
      {
        "key": "burst",
        "label": "Burst",
        "type": "number"
      },
      {
        "key": "period_secs",
        "label": "Period (Seconds)",
        "type": "number",
        "required": true
      },
      {
        "key": "action_on_exceeded",
        "label": "Action on Exceeded",
        "type": "select",
        "options": [
          {
            "label": "Throttle (429)",
            "value": "throttle"
          },
          {
            "label": "Block (403)",
            "value": "block"
          },
          {
            "label": "Audit (Log Only)",
            "value": "audit"
          },
          {
            "label": "Custom Response",
            "value": "custom_response"
          }
        ]
      },
      {
        "key": "rejected_code",
        "label": "HTTP Code",
        "type": "number"
      },
      {
        "key": "custom_message",
        "label": "Custom Message",
        "type": "text"
      },
      {
        "key": "response_headers",
        "label": "Response Headers",
        "type": "key_value"
      }
    ]
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "local",
          "distributed"
        ]
      },
      "redis": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "endpoint": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "db": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000
          },
          "on_error": {
            "type": "string",
            "enum": [
              "fallback_local",
              "pass",
              "block"
            ]
          },
          "reconnect_interval_secs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "pool_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "custom_lua_script": {
            "type": "string"
          },
          "tls": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "ca_cert_pem": {
                "type": "string"
              },
              "client_cert_pem": {
                "type": "string"
              },
              "client_key_pem": {
                "type": "string"
              },
              "insecure_skip_verify": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "algorithm": {
        "type": "string",
        "enum": [
          "token_bucket",
          "leaky_bucket",
          "fixed_window",
          "sliding_window"
        ]
      },
      "memory_size_mb": {
        "type": "integer",
        "minimum": 1,
        "maximum": 1024
      },
      "max_keys": {
        "type": "integer",
        "minimum": 16,
        "maximum": 5000000
      },
      "eviction_policy": {
        "type": "string",
        "enum": [
          "lru",
          "lfu",
          "fifo"
        ]
      },
      "overflow_strategy": {
        "type": "string",
        "enum": [
          "evict_and_track",
          "drop_new",
          "bypass_new"
        ]
      },
      "rules": {
        "type": "array",
        "maxItems": 64,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "path_prefix",
            "rate",
            "period_secs"
          ],
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 128
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "host": {
              "type": "string",
              "maxLength": 253
            },
            "path_prefix": {
              "type": "string",
              "maxLength": 8192
            },
            "limit_by": {
              "type": "string",
              "enum": [
                "client_ip",
                "header",
                "route_path"
              ]
            },
            "header_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "rate": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "period_secs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "burst": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            },
            "action_on_exceeded": {
              "type": "string",
              "enum": [
                "throttle",
                "block",
                "audit",
                "custom_response"
              ]
            },
            "rejected_code": {
              "type": "integer",
              "minimum": 200,
              "maximum": 599
            },
            "custom_message": {
              "type": "string",
              "maxLength": 2048
            },
            "response_headers": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "value"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}