{
  "key": "builtin/request-header-transform",
  "version": 1,
  "id": "request-header-transform",
  "name": "Request Header Transform",
  "category": "request_transformation",
  "description": "Adds and removes proxied request headers.",
  "renderer": "nginx-request-header-transform",
  "builtin": true,
  "default_config": {
    "add_headers": {},
    "remove_headers": []
  },
  "ui_schema": {
    "layout_type": "form",
    "fields": []
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "add_headers": {
        "type": "object",
        "additionalProperties": true,
        "properties": {}
      },
      "remove_headers": {
        "type": "array",
        "maxItems": 128,
        "items": {
          "type": "string",
          "maxLength": 128
        }
      }
    }
  }
}
