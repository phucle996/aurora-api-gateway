{
  "key": "builtin/traffic-split",
  "version": 1,
  "id": "traffic-split",
  "name": "Traffic Split",
  "category": "traffic_control",
  "description": "Weighted upstream traffic splitting for canary releases, A/B testing, and multi-version routing.",
  "renderer": "traffic-split",
  "builtin": true,
  "default_config": {
    "rules": [
      {
        "id": "default-split",
        "priority": 100,
        "origin": "*",
        "path_prefix": "/",
        "split_by": "client_ip",
        "splits": [
          {
            "upstream": "backend_v1",
            "weight": 80
          },
          {
            "upstream": "backend_v2",
            "weight": 20
          }
        ]
      }
    ]
  },
  "ui_schema": {
    "layout_type": "form",
    "fields": []
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "rules"
    ],
    "properties": {
      "rules": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "splits"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "origin": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "path_prefix": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "split_by": {
              "type": "string",
              "enum": [
                "client_ip",
                "header",
                "cookie",
                "random"
              ]
            },
            "header_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "splits": {
              "type": "array",
              "minItems": 2,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "upstream",
                  "weight"
                ],
                "properties": {
                  "upstream": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "weight": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 99
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
