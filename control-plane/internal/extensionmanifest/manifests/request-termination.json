{
  "key": "builtin/request-termination",
  "version": 1,
  "id": "request-termination",
  "name": "Request Termination",
  "category": "traffic_control",
  "description": "Early HTTP termination returning custom status codes, headers, and bodies for maintenance mode, API mocking, and decommissioned endpoints.",
  "renderer": "request-termination",
  "builtin": true,
  "default_config": {
    "enabled": true,
    "status_code": 503,
    "content_type": "application/json; charset=utf-8",
    "body": "{\"error\": \"Service undergoing planned maintenance. Please retry later.\"}",
    "headers": [
      {
        "name": "Retry-After",
        "value": "300"
      }
    ],
    "bypass_headers": [
      {
        "name": "X-Maintenance-Bypass",
        "value": "secret123"
      }
    ]
  },
  "ui_schema": {
    "layout_type": "form",
    "fields": []
  },
  "config_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "status_code": {
        "type": "integer",
        "minimum": 200,
        "maximum": 599
      },
      "content_type": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "body": {
        "type": "string",
        "maxLength": 65536
      },
      "headers": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "value"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "value": {
              "type": "string",
              "maxLength": 256
            }
          }
        }
      },
      "bypass_headers": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "value"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "value": {
              "type": "string",
              "maxLength": 256
            }
          }
        }
      },
      "rules": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "origin": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253
            },
            "path_prefix": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "methods": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "DELETE",
                  "PATCH",
                  "HEAD",
                  "OPTIONS"
                ]
              }
            },
            "status_code": {
              "type": "integer",
              "minimum": 200,
              "maximum": 599
            },
            "content_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "body": {
              "type": "string",
              "maxLength": 65536
            },
            "headers": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "value"
                ],
                "properties": {
                  "name": {
                    "type": "string",
